# Optional settings. The server needs no API keys: embeddings run locally.
#
# The code reads these from the process environment (it does not load a .env
# file). Export them in your shell, or put them in the "env" block of your MCP
# client's config (see examples/claude_desktop_config.json).

# Where Chroma stores the memory database. Default: ./data/chroma
# (relative to the directory the server is started from).
# MCP_MEMORY_PATH=./data/chroma

# Name of the Chroma collection. Use a different name to keep separate memories.
# Default: personal_memory
# MCP_MEMORY_COLLECTION=personal_memory
